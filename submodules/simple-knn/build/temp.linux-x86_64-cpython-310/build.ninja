ninja_required_version = 1.3
cxx = /home/mekya/miniconda3/envs/dynamic_gaussians/bin/x86_64-conda-linux-gnu-c++
nvcc = /usr/local/cuda-12.6/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/mekya/miniconda3/envs/dynamic_gaussians/include -fPIC -O2 -isystem /home/mekya/miniconda3/envs/dynamic_gaussians/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/mekya/miniconda3/envs/dynamic_gaussians/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/include -L/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/lib -L/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/lib/stubs -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/mekya/miniconda3/envs/dynamic_gaussians/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/include -L/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/lib -L/home/mekya/miniconda3/envs/dynamic_gaussians/targets/x86_64-linux/lib/stubs -fPIC -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/TH -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.6/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/TH -I/home/mekya/miniconda3/envs/dynamic_gaussians/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.6/include -I/home/mekya/miniconda3/envs/dynamic_gaussians/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -ccbin /home/mekya/miniconda3/envs/dynamic_gaussians/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/ext.o: compile /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/ext.cpp
build /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/simple_knn.o: cuda_compile /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/simple_knn.cu
build /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/spatial.o: cuda_compile /home/mekya/workspace/DynamicsGaussians/submodules/simple-knn/spatial.cu






